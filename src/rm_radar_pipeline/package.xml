<?xml version="1.0"?>
<package format="3">
  <name>rm_radar_pipeline</name>
  <version>0.1.0</version>
  <description>ROS2 adapter for the imported rm_radar detection, location and tracking pipeline.</description>
  <maintainer email="ajian@example.com">ajian</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>radar_interface</depend>
  <depend>geometry_msgs</depend>
  <depend>message_filters</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_eigen</depend>
  <depend>pcl_conversions</depend>
  <exec_depend>nn_detector</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
